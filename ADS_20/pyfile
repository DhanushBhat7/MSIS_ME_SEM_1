def count_occurrences(a, x):             # O(log n); uses the Searching section
   f = first_occurrence(a, x)
   if f == -1:
       return 0
   return last_occurrence(a, x) - f + 1
C12. Kth smallest in an unsorted array (quickselect)
Reuses partition from quick sort, but only recurses into the side that holds index k − 1.
def kth_smallest_array(a, k):            # average O(n), worst O(n^2)
   a = a[:]
   lo, hi, target = 0, len(a) - 1, k - 1
   while lo <= hi:
       p = partition(a, lo, hi)
       if p == target:
           return a[p]
       if p < target:
           lo = p + 1
       else:
           hi = p - 1
   return None
C13. Stack using one queue
from collections import deque

class StackUsingQueue:                   # push O(n), pop O(1)
   def __init__(self):
       self.q = deque()

   def push(self, x):
       self.q.append(x)
       for _ in range(len(self.q) - 1): # rotate so x is at the front
           self.q.append(self.q.popleft())

   def pop(self):
       return self.q.popleft()
C14. Josephus problem (circular list)
def josephus(n, k):                      # O(n * k); uses the CLL class
   cll = CLL()
   for i in range(1, n + 1):
       cll.add_tail(i)
   prev = cll._last()
   cur = cll.head
   while cur.next is not cur:           # until one person is left
       for _ in range(k - 1):
           prev, cur = cur, cur.next
       prev.next = cur.next             # remove cur
       cur = cur.next
   return cur.data
josephus(7, 3) → 4.
