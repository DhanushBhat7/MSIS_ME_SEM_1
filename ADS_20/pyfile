C1. Merge two sorted linked lists
def merge_sorted_lists(a, b):            # O(m + n), O(1) extra
   dummy = tail = Node(None)
   while a and b:
       if a.data <= b.data:
           tail.next = a; a = a.next
       else:
           tail.next = b; b = b.next
       tail = tail.next
   tail.next = a or b                   # attach leftovers
   return dummy.next
C2. Merge sort a linked list
Starting fast one node ahead makes slow stop at the first middle, so a 2-node list splits into 1 + 1 (otherwise it recurses forever).
def merge_sort_ll(head):                 # O(n log n), O(log n) stack
   if head is None or head.next is None:
       return head
   slow, fast = head, head.next         # fast starts 1 ahead -> first middle
   while fast and fast.next:
       slow = slow.next
       fast = fast.next.next
   right = slow.next
   slow.next = None                     # cut into two halves
   return merge_sorted_lists(merge_sort_ll(head), merge_sort_ll(right))
C3. Bubble sort a linked list
end marks where the sorted tail begins; each pass stops before it.
def bubble_sort_ll(head):                # O(n^2), O(1)
   if head is None:
       return head
   end = None                           # nodes from 'end' onward are sorted
   swapped = True
   while swapped:
       swapped = False
       cur = head
       while cur.next is not end:
           if cur.data > cur.next.data:
               cur.data, cur.next.data = cur.next.data, cur.data
               swapped = True
           cur = cur.next
       end = cur                        # biggest value is now at cur
   return head
C4. Insertion sort a linked list
def insertion_sort_ll(head):             # O(n^2), O(1)
   dummy = Node(None)
   cur = head
   while cur:
       nxt = cur.next
       p = dummy
       while p.next and p.next.data < cur.data:
           p = p.next                   # find the gap
       cur.next = p.next                # insert after p
       p.next = cur
       cur = nxt
   return dummy.next
C5. Bubble-sort two lists, then merge
head = merge_sorted_lists(bubble_sort_ll(l1.head), bubble_sort_ll(l2.head))
Cost: O(m² + n²) for the two bubble sorts + O(m + n) for the merge. Good follow-up answer: "merge sort on the combined list would be O((m + n) log(m + n)), which is faster for large inputs."
C6. Sorted array to a balanced BST
def sorted_to_bst(a, lo, hi):            # O(n); call sorted_to_bst(a, 0, len(a)-1)
   if lo > hi:
       return None
   mid = (lo + hi) // 2
   node = TNode(a[mid])                 # middle becomes root
   node.left = sorted_to_bst(a, lo, mid - 1)
   node.right = sorted_to_bst(a, mid + 1, hi)
   return node
C7. Kth smallest in a BST (iterative inorder with a stack)
def kth_smallest(root, k):               # O(h + k)
   stack, cur = [], root
   while stack or cur:
       while cur:                       # go as far left as possible
           stack.append(cur)
           cur = cur.left
       cur = stack.pop()
       k -= 1
       if k == 0:
           return cur.key
       cur = cur.right
   return None
C8. Is it a valid BST?
Checking only left < node < right at each node is the classic wrong answer; a deep grandchild can break the rule. Pass the allowed range down instead.
def is_bst(node, low=float("-inf"), high=float("inf")):
   if node is None:
       return True
   if not (low < node.key < high):
       return False
   return is_bst(node.left, low, node.key) and is_bst(node.right, node.key, high)
C9. Balanced brackets
def is_balanced(s):                      # O(n), O(n)
   pairs = {")": "(", "]": "[", "}": "{"}
   st = []
   for ch in s:
       if ch in "([{":
           st.append(ch)
       elif ch in pairs:
           if not st or st.pop() != pairs[ch]:
               return False
   return len(st) == 0
C10. Reverse a queue using a stack
def reverse_queue(q):                    # q is a deque; O(n), O(n)
   st = []
   while q:
       st.append(q.popleft())
   while st:
       q.append(st.pop())
   return q
