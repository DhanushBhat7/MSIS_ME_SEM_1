Binary search tree (BST)
One rule: smaller goes left, bigger goes right, at every node. That rule means each comparison throws away half the tree, like binary search. Every operation follows one path from root to leaf, so it costs O(h), where h is the height.
Insert 50, 30, 70, 20, 40, 60, 80:

           50
         /    \
       30      70
      /  \    /  \
    20   40  60   80

Inorder   (L N R): 20 30 40 50 60 70 80   <- always SORTED
Preorder  (N L R): 50 30 20 40 70 60 80   <- root first (copying a tree)
Postorder (L R N): 20 40 30 60 80 70 50   <- root last (deleting a tree)
Level order (queue): 50 30 70 20 40 60 80
Delete has three cases (the most asked BST question):
1. Leaf (delete 20): just remove it, return None to the parent.
2. One child (delete 30 after 20 is gone): return the child to the parent; it takes the node's place.
3. Two children (delete 50): copy the inorder successor (smallest key in the right subtree, here 60) into the node, then delete that successor from the right subtree. The successor never has a left child, so that second delete is case 1 or 2.
Memory hook: "0 or 1 child: hand the parent the other child. 2 children: copy the successor, delete the successor."
from collections import deque

class TNode:
   def __init__(self, key):
       self.key = key
       self.left = None
       self.right = None

class BST:
   def __init__(self):
       self.root = None

   # ---- insert: O(h)
   def insert(self, key):
       self.root = self._insert(self.root, key)

   def _insert(self, node, key):
       if node is None:
           return TNode(key)
       if key < node.key:
           node.left = self._insert(node.left, key)
       elif key > node.key:
           node.right = self._insert(node.right, key)
       return node                      # duplicates are ignored

   # ---- search: O(h)
   def search(self, key):
       cur = self.root
       while cur:
           if key == cur.key:
               return True
           cur = cur.left if key < cur.key else cur.right
       return False

   def find_min(self):                  # leftmost node
       cur = self.root
       while cur and cur.left:
           cur = cur.left
       return cur.key if cur else None

   def find_max(self):                  # rightmost node
       cur = self.root
       while cur and cur.right:
           cur = cur.right
       return cur.key if cur else None

   # ---- delete: O(h)
   def delete(self, key):
       self.root = self._delete(self.root, key)

   def _delete(self, node, key):
       if node is None:
           return None
       if key < node.key:
           node.left = self._delete(node.left, key)
       elif key > node.key:
           node.right = self._delete(node.right, key)
       else:
           if node.left is None:        # case 1 (leaf) & case 2 (one child)
               return node.right
           if node.right is None:
               return node.left
           succ = node.right            # case 3: two children
           while succ.left:             # inorder successor = min of right subtree
               succ = succ.left
           node.key = succ.key          # copy successor
           node.right = self._delete(node.right, succ.key)  # delete successor
       return node

   # ---- traversals: O(n)
   def inorder(self):                   # Left, Node, Right -> SORTED
       out = []
       def go(n):
           if n:
               go(n.left); out.append(n.key); go(n.right)
       go(self.root)
       return out

   def preorder(self):                  # Node, Left, Right
       out = []
       def go(n):
           if n:
               out.append(n.key); go(n.left); go(n.right)
       go(self.root)
       return out

   def postorder(self):                 # Left, Right, Node
       out = []
       def go(n):
           if n:
               go(n.left); go(n.right); out.append(n.key)
       go(self.root)
       return out

   def level_order(self):               # BFS with a queue
       out = []
       if self.root is None:
           return out
       q = deque([self.root])
       while q:
           n = q.popleft()
           out.append(n.key)
           if n.left:
               q.append(n.left)
           if n.right:
               q.append(n.right)
       return out

   def height(self, node="root"):       # edges on longest path; empty = -1
       if node == "root":
           node = self.root
       if node is None:
           return -1
       return 1 + max(self.height(node.left), self.height(node.right))

   def count_leaves(self, node="root"):
       if node == "root":
           node = self.root
       if node is None:
           return 0
       if node.left is None and node.right is None:
           return 1
       return self.count_leaves(node.left) + self.count_leaves(node.right)
Height convention varies: some teachers count nodes (a single node has height 1, empty tree 0). Check which your course uses and say it in your answer.
