Searching
Linear search checks every item and works on anything. Binary search halves the range each step but needs sorted data and index access (so not on a linked list).
def linear_search(a, x):                 # O(n), works on unsorted data
   for i in range(len(a)):
       if a[i] == x:
           return i
   return -1

def binary_search(a, x):                 # O(log n), a MUST be sorted
   lo, hi = 0, len(a) - 1
   while lo <= hi:
       mid = (lo + hi) // 2
       if a[mid] == x:
           return mid
       elif a[mid] < x:
           lo = mid + 1                 # go right
       else:
           hi = mid - 1                 # go left
   return -1

def binary_search_rec(a, x, lo, hi):     # recursive version, O(log n) stack
   if lo > hi:
       return -1
   mid = (lo + hi) // 2
   if a[mid] == x:
       return mid
   if a[mid] < x:
       return binary_search_rec(a, x, mid + 1, hi)
   return binary_search_rec(a, x, lo, mid - 1)
 
a = [1, 3, 5, 7, 9, 11]
find 7: mid=2 (5<7, go right) -> mid=4 (9>7, go left) -> mid=3 (7) found at 3
find 8: mid=2 -> mid=4 -> mid=3 (7<8, lo=4) -> lo > hi, return -1
Three places students lose marks: while lo <= hi (not <), lo = mid + 1 and hi = mid - 1 (not mid, or it can loop forever), and forgetting that the input must be sorted.
Variant: first and last occurrence (duplicates)
On a hit, record it and keep searching left (first) or right (last). Count of x = last − first + 1, still O(log n).
def first_occurrence(a, x):              # keep searching LEFT after a hit
   lo, hi, ans = 0, len(a) - 1, -1
   while lo <= hi:
       mid = (lo + hi) // 2
       if a[mid] == x:
           ans = mid
           hi = mid - 1
       elif a[mid] < x:
           lo = mid + 1
       else:
           hi = mid - 1
   return ans

def last_occurrence(a, x):               # keep searching RIGHT after a hit
   lo, hi, ans = 0, len(a) - 1, -1
   while lo <= hi:
       mid = (lo + hi) // 2
       if a[mid] == x:
           ans = mid
           lo = mid + 1
       elif a[mid] < x:
           lo = mid + 1
       else:
           hi = mid - 1
   return ans
