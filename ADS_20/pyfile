Quick sort — "pick a pivot, small to the left, big to the right, repeat on each side"
partition puts the pivot (last element) in its final place and returns that index. Worst case O(n²) happens when the pivot is always the smallest or largest, for example on already sorted input with a last-element pivot.
def partition(a, lo, hi):                # Lomuto: pivot = last element
   pivot = a[hi]
   i = lo - 1                           # end of the "small" zone
   for j in range(lo, hi):
       if a[j] <= pivot:
           i += 1
           a[i], a[j] = a[j], a[i]
   a[i + 1], a[hi] = a[hi], a[i + 1]    # pivot to its final place
   return i + 1

def quick_sort(a, lo=0, hi=None):
   if hi is None:
       hi = len(a) - 1
   if lo < hi:
       p = partition(a, lo, hi)
       quick_sort(a, lo, p - 1)
       quick_sort(a, p + 1, hi)
   return a
 
partition [5, 2, 4, 1, 3], pivot 3  ->  [2, 1, 3, 5, 4], pivot at index 2
then sort [2, 1] and [5, 4] the same way
Easy-to-remember version (good for explaining the idea; uses O(n) extra space, so write the in-place one if the question says "in place"):
def quick_sort_simple(a):
   if len(a) <= 1:
       return a
   pivot, rest = a[0], a[1:]
   return (quick_sort_simple([x for x in rest if x < pivot]) + [pivot] +
           quick_sort_simple([x for x in rest if x >= pivot]))
Heap sort — "build a max-heap, swap the root to the end, shrink, fix the root"
An array as a tree: children of i are 2i+1 and 2i+2, parent is (i-1)//2, last parent is n//2 - 1. heapify sinks a node until both children are smaller.
def heapify(a, n, i):                    # sift node i down in a max-heap of size n
   largest = i
   l, r = 2 * i + 1, 2 * i + 2
   if l < n and a[l] > a[largest]:
       largest = l
   if r < n and a[r] > a[largest]:
       largest = r
   if largest != i:
       a[i], a[largest] = a[largest], a[i]
       heapify(a, n, largest)

def heap_sort(a):
   n = len(a)
   for i in range(n // 2 - 1, -1, -1):  # 1. build max-heap (last parent -> root)
       heapify(a, n, i)
   for end in range(n - 1, 0, -1):      # 2. move max to end, shrink, fix root
       a[0], a[end] = a[end], a[0]
       heapify(a, end, 0)
   return a
 
