Why merge sort for linked lists? Quick sort and heap sort need a[i] jumps; a linked list has none. Merge sort only walks forward, which lists do well. Bubble and insertion also work on lists by walking forward.
Linked lists
A linked list is a chain of boxes; each box holds data and an arrow to the next box. You only hold the first box (head), so reaching anything means walking from the head.
Singly:    head -> [1|*] -> [2|*] -> [3|None]
Doubly:    None <- [1] <-> [2] <-> [3] -> None      (head and tail)
Circular:  head -> [1] -> [2] -> [3] --+
                   ^-------------------+           (last.next is head)
Three rules that solve most bugs:
• To change a node, stop at the node before it (while cur.next ...).
• When inserting, connect the new node first, then break the old link: n.next = cur.next then cur.next = n. Swap these two lines and you lose the rest of the list.
• To delete, skip it: cur.next = cur.next.next.
Singly linked list (this is also assignment Q1)
class Node:
   def __init__(self, data):
       self.data = data
       self.next = None

class SLL:
   def __init__(self):
       self.head = None

   def add_head(self, data):            # O(1)
       n = Node(data)
       n.next = self.head
       self.head = n

   def add_tail(self, data):            # O(n)  (O(1) if you keep a tail pointer)
       n = Node(data)
       if self.head is None:
           self.head = n
           return
       cur = self.head
       while cur.next:                  # stop AT the last node
           cur = cur.next
       cur.next = n

   def delete_head(self):               # O(1)
       if self.head is None:
           return None
       val = self.head.data
       self.head = self.head.next
       return val

   def delete_tail(self):               # O(n) - need the second-last node
       if self.head is None:
           return None
       if self.head.next is None:       # only one node
           val = self.head.data
           self.head = None
           return val
       cur = self.head
       while cur.next.next:             # stop at SECOND-last node
           cur = cur.next
       val = cur.next.data
       cur.next = None
       return val

   def search(self, key):               # O(n) - returns the node (or None)
       cur = self.head
       while cur:
           if cur.data == key:
               return cur
           cur = cur.next
       return None

   def add_after(self, key, data):      # O(n) to find, O(1) to link
       cur = self.search(key)
       if cur is None:
           return False
       n = Node(data)
       n.next = cur.next                # 1. new node points to the rest
       cur.next = n                     # 2. old node points to new node
       return True

   def delete_after(self, key):         # O(n)
       cur = self.search(key)
       if cur is None or cur.next is None:
           return None
       val = cur.next.data
       cur.next = cur.next.next         # skip it
       return val

   def to_list(self):                   # for printing / checking
       out, cur = [], self.head
       while cur:
           out.append(cur.data)
           cur = cur.next
       return out
Doubly linked list
Each node also has prev, and the list keeps a tail. Payoff: delete at tail becomes O(1) and you can walk backwards. Cost: every insert or delete fixes two links per side, and you must update head/tail when the list becomes empty.
class DNode:
   def __init__(self, data):
       self.data = data
       self.prev = None
       self.next = None

class DLL:
   def __init__(self):
       self.head = None
       self.tail = None

   def add_head(self, data):            # O(1)
       n = DNode(data)
       if self.head is None:
           self.head = self.tail = n
           return
       n.next = self.head
       self.head.prev = n
       self.head = n

   def add_tail(self, data):            # O(1) thanks to tail
       n = DNode(data)
       if self.tail is None:
           self.head = self.tail = n
           return
       n.prev = self.tail
       self.tail.next = n
       self.tail = n

   def delete_head(self):               # O(1)
       if self.head is None:
           return None
       val = self.head.data
       self.head = self.head.next
       if self.head:
           self.head.prev = None
       else:
           self.tail = None             # list became empty
       return val

   def delete_tail(self):               # O(1) - big win over SLL
       if self.tail is None:
           return None
       val = self.tail.data
       self.tail = self.tail.prev
       if self.tail:
           self.tail.next = None
       else:
           self.head = None
       return val

   def add_after(self, key, data):      # O(n) to find
       cur = self.head
       while cur and cur.data != key:
           cur = cur.next
       if cur is None:
           return False
       n = DNode(data)
       n.prev = cur
       n.next = cur.next
       if cur.next:
           cur.next.prev = n
       else:
           self.tail = n                # inserted after the last node
       cur.next = n
       return True

   def delete(self, key):               # O(n) to find, O(1) to unlink
       cur = self.head
       while cur and cur.data != key:
           cur = cur.next
       if cur is None:
           return False
       if cur.prev:
           cur.prev.next = cur.next
       else:
           self.head = cur.next
       if cur.next:
           cur.next.prev = cur.prev
       else:
           self.tail = cur.prev
       return True
Circular singly linked list
Same nodes as SLL, but the last node points back to head. There is no None to stop at, so every loop stops when it comes back to head. A one-node list points to itself.
class CLL:
   def __init__(self):
       self.head = None

   def _last(self):                     # O(n)
       cur = self.head
       while cur.next is not self.head:
           cur = cur.next
       return cur

   def add_tail(self, data):            # O(n)
       n = Node(data)
       if self.head is None:
           self.head = n
           n.next = n                   # points to itself
           return
       last = self._last()
       last.next = n
       n.next = self.head

   def add_head(self, data):            # O(n): last must point to new head
       n = Node(data)
       if self.head is None:
           self.head = n
           n.next = n
           return
       last = self._last()
       n.next = self.head
       last.next = n
       self.head = n

   def delete_head(self):               # O(n)
       if self.head is None:
           return None
       val = self.head.data
       if self.head.next is self.head:  # only one node
           self.head = None
           return val
       last = self._last()
       self.head = self.head.next
       last.next = self.head
       return val

   def to_list(self):
       out = []
       if self.head is None:
           return out
       cur = self.head
       while True:                      # do-while: visit head first
           out.append(cur.data)
           cur = cur.next
           if cur is self.head:
               break
       return out
Exam tip: if you keep a tail pointer instead of head in a circular list, tail.next is the head, and both add-at-head and add-at-tail become O(1).
