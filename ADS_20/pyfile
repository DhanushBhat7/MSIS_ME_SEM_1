Merge sort — "split in half, sort each half, zip them together"
Divide and conquer. All the real work is in merge, which walks two sorted lists with two pointers. That merge function is reused in many combo questions (merge two sorted lists, common elements, sort a linked list).
def merge(left, right):                  # merge two SORTED lists: O(n)
   res = []
   i = j = 0
   while i < len(left) and j < len(right):
       if left[i] <= right[j]:          # <= keeps it stable
           res.append(left[i]); i += 1
       else:
           res.append(right[j]); j += 1
   res.extend(left[i:])                 # leftovers
   res.extend(right[j:])
   return res

def merge_sort(a):
   if len(a) <= 1:
       return a
   mid = len(a) // 2
   return merge(merge_sort(a[:mid]), merge_sort(a[mid:]))
 
